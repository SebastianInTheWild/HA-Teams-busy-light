{
  "config": {
    "step": {
      "user": {
        "title": "Teams Busy Light",
        "description": "Creates a webhook that receives the Teams status from the Windows script (Get-TeamsStatus.ps1).",
        "data": {
          "name": "Name suffix"
        },
        "data_description": {
          "name": "Enter a person or computer name; \"Teams\" is added automatically (for example, Anna becomes \"Teams Anna\"). Leave empty for just \"Teams\"."
        }
      }
    },
    "create_entry": {
      "default": "Done! Enter this webhook URL when running Install.ps1 on your Windows computer:\n\n`{webhook_url}`\n\nYou can view it again in the integration options."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Teams Busy Light",
        "description": "Webhook URL for Install.ps1 / Settings.ps1:\n\n`{webhook_url}`",
        "data": {
          "timeout": "Timeout"
        },
        "data_description": {
          "timeout": "Set Teams to offline when the computer has not reported for this many seconds (e.g. because it is switched off). 0 disables it."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Status",
        "state": {
          "available": "Available",
          "busy": "Busy",
          "in_a_call": "In a call",
          "in_a_meeting": "In a meeting",
          "presenting": "Presenting",
          "focusing": "Focusing",
          "do_not_disturb": "Do not disturb",
          "be_right_back": "Be right back",
          "away": "Away",
          "offline": "Offline"
        },
        "state_attributes": {
          "computer": {
            "name": "Computer"
          },
          "teams_language": {
            "name": "Teams language"
          },
          "last_seen": {
            "name": "Last seen"
          }
        }
      },
      "activity": {
        "name": "Activity",
        "state": {
          "not_in_call": "Not in a call",
          "in_call": "In a call",
          "incoming_call": "Incoming call",
          "outgoing_call": "Outgoing call"
        }
      }
    }
  }
}
